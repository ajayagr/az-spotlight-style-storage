meta {
  name: Run MomentSync (Async)
  type: http
  seq: 1
}

post {
  url: {{host}}/momentsync/async
  body: json
  auth: none
}

headers {
  X-API-Key: {{api_key}}
}

body:json {
  {
    "styled_path": "styled/",
    "output_path": "moments/",
    "style_folders": []
  }
}

docs {
  Start MomentSync as a background job.
  Creates time-of-day and season variations (24 per image).
  Processes all images in styled/ folder including styled/original/.
  Returns immediately with a job ID.
  Use GET /momentsync/status/{job_id} to check progress.
  Requires API key authentication.
  
  Parameters:
  - styled_path: Path containing styled images (default: "styled/")
  - output_path: Output path for moment variations (default: "moments/")
  - style_folders: Specific style folders to process (empty = all, including 'original')
  
  Output structure:
  - moments/original/{moment}/ - Variations from original source images
  - moments/{style}/{moment}/ - Variations from styled images
  
  Response includes:
  - job_id: UUID to poll for status
  - status: "started"
  - total_expected: Total moment images expected
  - to_generate: Number of images to generate
  - to_skip: Number of images already existing
  - to_delete: Number of orphaned images to delete
  
  Note: Jobs are stored in-memory and may be lost on server restart.
}
