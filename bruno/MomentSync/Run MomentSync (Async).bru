meta {
  name: Run MomentSync (Async)
  type: http
  seq: 1
}

post {
  url: {{host}}/momentsync/async
  body: json
  auth: none
}

headers {
  X-API-Key: {{api_key}}
}

body:json {
  {
    "styled_path": "styled/",
    "output_path": "moments/",
    "style_folders": []
  }
}

docs {
  Start MomentSync as a background job.
  Creates time-of-day and season variations (24 per styled image).
  Returns immediately with a job ID.
  Use GET /momentsync/status/{job_id} to check progress.
  Requires API key authentication.
  
  Response includes:
  - job_id: UUID to poll for status
  - status: "started"
  - total_expected: Total moment images expected
  - to_generate: Number of images to generate
  - to_skip: Number of images already existing
  - to_delete: Number of orphaned images to delete
  
  Note: Jobs are stored in-memory and may be lost on server restart.
}
